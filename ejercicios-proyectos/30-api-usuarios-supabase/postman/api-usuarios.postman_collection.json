        {
          "name": "02 Registrar cuenta",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"emailCuenta\", \"cuenta\" + Date.now() + \"@email.com\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código 201\", function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"La respuesta no incluye el hash\", function () {",
                  "  pm.expect(pm.response.json().datos).to.not.have.property(\"password_hash\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "201 con la cuenta creada, sin el hash de la contraseña. Crea un email nuevo en cada ejecución y lo guarda en la variable emailCuenta.",
