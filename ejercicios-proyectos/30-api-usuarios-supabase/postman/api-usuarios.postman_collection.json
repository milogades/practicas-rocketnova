{
  "info": {
    "name": "API de usuarios con Supabase - Ejercicio 30",
    "description": "Pruebas de la API de usuarios (Node.js + Express + Supabase) con autenticación JWT. Ejecutar en orden: la 02 registra una cuenta nueva, la 06 hace login y guarda el token, y las peticiones protegidas lo envían como Bearer Token (configurado en la colección). La 15 crea un usuario de prueba y la 21 lo borra.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
