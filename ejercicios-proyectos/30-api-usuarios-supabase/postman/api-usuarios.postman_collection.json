    {
      "name": "06 Crear usuario",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Código 201\", function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "pm.test(\"El email se guarda en minúsculas\", function () {",
              "  pm.expect(pm.response.json().datos.email).to.eql(pm.response.json().datos.email.toLowerCase());",
              "});",
              "pm.collectionVariables.set(\"idNuevo\", pm.response.json().datos.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/usuarios",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "usuarios"
          ]
        },
        "description": "201 con el usuario creado y su id nuevo. El email lleva la hora para que no se repita al volver a ejecutar la colección. Guarda el id en la variable idNuevo para las peticiones 10 a 13.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Lucia Prueba\",\n  \"email\": \"Lucia{{$timestamp}}@Email.com\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
